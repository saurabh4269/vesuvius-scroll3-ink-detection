# Prajna HPC — Credentials Template
# Copy to .env and fill in the REQUIRED fields.
# Run prajna_setup() once — it auto-fills everything below that line.
#
# PRAJNA_TOTP_SECRET: the base32 key printed during Google Authenticator setup
#   ("Your new secret key is: XXXXX..."). Also in ~/.google_authenticator on
#   Prajna — it's the first line of that file (before any " settings lines).

# ── REQUIRED (fill these in) ──────────────────────────────────────────────────
PRAJNA_USER=your_username
PRAJNA_PASSWORD=your_password
PRAJNA_TOTP_SECRET=your_totp_secret_key

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Email for SLURM job notifications. Leave blank to disable.
PRAJNA_EMAIL=

# ── AUTO-FILLED on first run (leave blank) ────────────────────────────────────
PRAJNA_GROUP=
PRAJNA_UID=
PRAJNA_GID=

# Emergency TOTP scratch codes (auto-filled from ~/.google_authenticator on Prajna).
# Comment out a code after using it manually.
PRAJNA_SCRATCH_1=
PRAJNA_SCRATCH_2=
PRAJNA_SCRATCH_3=
PRAJNA_SCRATCH_4=
PRAJNA_SCRATCH_5=
